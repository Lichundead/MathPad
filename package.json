{
  "name": "mathpad",
  "version": "1.0.0",
  "description": "Editor de f\u00f3rmulas matem\u00e1ticas \u2014 Capacitor/Android",
  "scripts": {
    "build:css": "tailwindcss -i ./www/css/input.css -o ./www/css/styles.css --minify",
    "serve": "cd www && python3 -m http.server 5173",
    "sync": "npm run check && npm run build:css && cap sync",
    "android": "npm run sync && cap open android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "check": "node check.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.18.7",
    "mathlive": "^0.110.0",
    "tailwindcss": "^3.4.17"
  }
}
